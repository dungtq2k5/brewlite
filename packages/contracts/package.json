{
  "name": "@brewlite/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    },
    "./proto-paths.js": {
      "types": "./dist/proto-paths.d.ts",
      "default": "./dist/proto-paths.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --root .",
    "proto:generate": "buf generate",
    "proto:lint": "buf lint"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "@nestjs/microservices": "^11.0.1",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@brewlite/config": "workspace:*",
    "@types/node": "^24.0.0",
    "ts-proto": "^2.4.1",
    "vitest": "^4.0.0"
  }
}
