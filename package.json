{
  "name": "brewlite",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "turbo run db:generate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:objects": "turbo run db:objects",
    "db:deploy": "turbo run db:deploy",
    "db:setup": "turbo run db:setup",
    "db:drift": "turbo run db:drift",
    "proto:generate": "turbo run proto:generate",
    "proto:lint": "turbo run proto:lint"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "eslint": "^9.17.0",
    "lint-staged": "^15.2.10",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  }
}
