  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": ["CUSTOMER", "STAFF", "ADMIN"]
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "menu.manage",
                    "stock.update",
                    "order.board.read",
                    "order.status.update",
                    "order.cancel.paid",
                    "order.read.all",
                    "promotion.manage",
                    "user.manage",
                    "report.read"
                  ]
                }
              },
              "hasPassword": {
                "type": "boolean"
              },
              "preferredLocale": {
                "type": "string",
                "enum": ["en", "vi"]
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "role",
              "permissions",
              "hasPassword",
              "preferredLocale",
              "createdAt"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "preferredLocale": {
            "type": "string",
            "enum": ["en", "vi"]
          }
        },
        "required": ["email", "password", "fullName"],
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": ["email", "password"],
        "additionalProperties": false
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string"
          }
        },
        "required": ["accessToken", "accessTokenExpiresAt"]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["refreshToken"],
        "additionalProperties": false
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["CUSTOMER", "STAFF", "ADMIN"]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "menu.manage",
                "stock.update",
                "order.board.read",
                "order.status.update",
                "order.cancel.paid",
                "order.read.all",
                "promotion.manage",
                "user.manage",
                "report.read"
              ]
            }
          },
          "hasPassword": {
            "type": "boolean"
          },
          "preferredLocale": {
            "type": "string",
            "enum": ["en", "vi"]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "permissions",
          "hasPassword",
          "preferredLocale",
          "createdAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "preferredLocale": {
            "type": "string",
            "enum": ["en", "vi"]
          }
        },
        "additionalProperties": false
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "vi": {
                "type": "string"
              }
            },
            "required": ["en", "vi"]
          }
        },
        "required": ["id", "name"]
      },
      "ProductSummaryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "vi": {
                "type": "string"
              }
            },
            "required": ["en", "vi"]
          },
          "imageUrl": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fromPriceVnd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isSoldOut": {
            "type": "boolean"
          }
        },
        "required": ["id", "categoryId", "name", "imageUrl", "fromPriceVnd", "isSoldOut"]
      },
      "ProductDetailResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "vi": {
                "type": "string"
              }
            },
            "required": ["en", "vi"]
          },
          "imageUrl": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fromPriceVnd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isSoldOut": {
            "type": "boolean"
          },
          "description": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "vi": {
                "type": "string"
              }
            },
            "required": ["en", "vi"],
            "nullable": true
          },
          "basePriceVnd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "enum": ["S", "M", "L"]
                },
                "priceDeltaVnd": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["size", "priceDeltaVnd"]
            }
          },
          "toppings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "vi": {
                      "type": "string"
                    }
                  },
                  "required": ["en", "vi"]
                },
                "priceVnd": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["id", "name", "priceVnd"]
            }
          },
          "maxToppings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "imageUrl",
          "fromPriceVnd",
          "isSoldOut",
          "description",
          "basePriceVnd",
          "sizes",
          "toppings",
          "maxToppings"
        ]
      }
    }
  }
}
