generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.VarChar(254)
  passwordHash    String?   @map("password_hash") @db.Char(60)
  firebaseUid     String?   @unique @map("firebase_uid") @db.VarChar(128)
  fullName        String    @map("full_name") @db.VarChar(100)
  role            String    @default("CUSTOMER") @db.VarChar(16) /// Role in @brewlite/contracts
  preferredLocale String    @default("en") @map("preferred_locale") @db.VarChar(8) /// Locale in @brewlite/contracts
  isLocked        Boolean   @default(false) @map("is_locked")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  lockReason      String?   @map("lock_reason") @db.VarChar(255)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?   @map("deleted_by_id") @db.Uuid

  deletedBy User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleted   User[]    @relation("UserDeletedBy")
  sessions  Session[]

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
