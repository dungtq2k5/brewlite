{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "filenames": ["src", "generated"]
      }
    },
    "typeCheck": true,
    "assets": [],
    "watchAssets": false
  }
}
