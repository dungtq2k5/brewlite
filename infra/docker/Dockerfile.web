# The Next.js web app, built from the standalone output. NEXT_PUBLIC_* values are compiled into
# the browser bundle, so they are build arguments, not runtime variables.
FROM node:24.14.0-alpine AS prune
WORKDIR /repo
RUN corepack enable
COPY . .
RUN npx turbo prune @brewlite/web --docker

FROM node:24.14.0-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY --from=prune /repo/out/json/ .
COPY --from=prune /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=prune /repo/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --frozen-lockfile
COPY --from=prune /repo/out/full/ .
ARG NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-brewlite.firebaseapp.com
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-brewlite
ARG NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:29099
ARG NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=false
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY} \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN} \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID} \
    NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=${NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL} \
    NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=${NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED}
# Read at import time by the build's page collection; the runtime value comes from Compose.
ENV API_URL=http://gateway:23100/api/v1
RUN pnpm turbo run build --filter @brewlite/web

FROM node:24.14.0-alpine AS runtime
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=23000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
USER node
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
CMD ["node", "apps/web/server.js"]
