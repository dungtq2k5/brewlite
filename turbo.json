{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL*", "PRISMA_DB", "NODE_ENV", "API_URL"],
  "tasks": {
    "db:generate": {
      "outputs": ["generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "db:migrate:dev": {
      "cache": false
    },
    "db:objects": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:setup": {
      "cache": false
    },
    "db:drift": {
      "cache": false
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "proto:generate": {
      "outputs": ["src/generated/**"]
    },
    "proto:lint": {
      "outputs": []
    }
  }
}
